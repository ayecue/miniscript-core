{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "lib": [
      "ESNext"
    ],
    "useDefineForClassFields": false,
    "allowJs": true,
    "outDir": "dist",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": [
      "ts-transform-args",
      "@types/node",
      "@types/jest"
    ],
    "plugins": [
      { "transform": "ts-transform-args" }
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}